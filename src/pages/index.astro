---
/* Home page: your photo and a hello, a short intro and your links, then the project archive. */
import Base from "../layouts/Base.astro";
import Avatar from "../components/Avatar.astro";
import ContactLinks from "../components/ContactLinks.astro";
import ProjectList from "../components/ProjectList.astro";
import { getProjects } from "../lib/projects";
import { site } from "../content/site";

const projects = await getProjects();

// Splits the greeting around the 👋, so the hand can be animated on its own
const [beforeWave, ...rest] = site.greeting.split("👋");
const afterWave = rest.join("👋");
---

<Base>
  <section class="hello">
    <div class="top">
      <Avatar />
      <h1 class="greeting">
        {beforeWave}
        {rest.length > 0 && <span class="wave">👋</span>}
        {afterWave}
      </h1>
    </div>
    <p class="intro">{site.intro}</p>
    <ContactLinks size="large" />
  </section>

  <ProjectList projects={projects} />
</Base>

<style>
  .hello {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
    margin-bottom: 4.5rem;
  }

  /* Photo and hello side by side */
  .top {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .greeting {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .intro {
    max-width: 34rem;
    margin-bottom: 0.25rem;
    font-family: var(--font-serif);
    font-size: 1.4rem;
    line-height: 1.45;
    color: color-mix(in srgb, var(--text) 82%, var(--bg));
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  /* The hand waves a few times when the page opens, then rests */
  .wave {
    display: inline-block;
    transform-origin: 70% 80%;
    animation: wave 1.6s ease-in-out 0.4s 1;
  }

  @keyframes wave {
    0%, 60%, 100% {
      transform: rotate(0deg);
    }
    10%, 30% {
      transform: rotate(16deg);
    }
    20%, 40% {
      transform: rotate(-8deg);
    }
    50% {
      transform: rotate(10deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wave {
      animation: none;
    }
  }

  @media (max-width: 34rem) {
    .top {
      gap: 1.1rem;
    }

    .top :global(.avatar) {
      width: 6rem;
      height: 6rem;
    }

    .greeting {
      font-size: 2rem;
    }

    .intro {
      font-size: 1.25rem;
    }
  }
</style>
