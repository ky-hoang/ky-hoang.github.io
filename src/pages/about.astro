---
/*
  About page. The story comes from src/content/about.md; skills and awards
  come from src/content/resume.ts. Your experience is on the home page and
  your links are in the footer.
*/
import Base from "../layouts/Base.astro";
import { Content } from "../content/about.md";
import { skills, awards } from "../content/resume";
import { site } from "../content/site";
---

<Base
  title="About"
  description="Ky Hoang: Data Science student at UC Berkeley, Operations Specialist at Apple, hackathon regular, and happiest camping or backpacking."
>
  <h1 class="page-title">About</h1>

  <div class="prose">
    <Content />
  </div>

  <div class="sections">
    <section aria-labelledby="skills-heading">
      <h2 id="skills-heading" class="label">Skills</h2>
      <dl class="skills">
        {
          skills.map((skill) => (
            <div class="skill">
              <dt>{skill.group}</dt>
              <dd>
                <p class="items">{skill.items.join(" · ")}</p>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="awards-heading">
      <h2 id="awards-heading" class="label">Awards</h2>
      <ul class="awards" role="list">
        {
          awards.map((award) => (
            <li>
              <span class="award-name">{award.name}</span>
              <span class="award-from">{award.from}</span>
              <span class="award-year">{award.year}</span>
            </li>
          ))
        }
      </ul>
    </section>

    {
      site.resume && (
        <p class="resume-cta">
          <a href={site.resume}>Download my résumé (PDF)</a>
        </p>
      )
    }
  </div>
</Base>

<style>
  .page-title {
    margin-bottom: 1.5rem;
  }

  .sections {
    display: grid;
    gap: 3rem;
    margin-top: 3.5rem;
  }

  .label {
    margin-bottom: 0.75rem;
  }

  /* ---------- Skills ---------- */

  .skills {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .skill {
    display: grid;
    gap: 0.5rem;
  }

  dt {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  dd {
    margin: 0;
  }

  .items {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  /* ---------- Awards ---------- */

  .awards {
    border-top: 1px solid var(--line);
  }

  .awards li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.125rem 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
  }

  .award-name {
    font-weight: 600;
  }

  .award-from {
    grid-column: 1;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .award-year {
    grid-column: 2;
    grid-row: 1;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    padding-top: 0.25rem;
  }

  .resume-cta a {
    color: var(--accent);
    font-weight: 500;
  }
</style>
