---
/*
  The page for a single project. Astro makes one of these for every folder
  in src/content/projects/, using the folder name as the address.
*/
import { render } from "astro:content";
import { Image, getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { getProjects, typeLabel, yearOf, type Project } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { id: project.id },
    // "Next" is the one below it in the home page list; the last loops back to the first
    props: { project, next: projects.length > 1 ? projects[(i + 1) % projects.length] : undefined },
  }));
}

interface Props {
  project: Project;
  next?: Project;
}

const { project, next } = Astro.props;
const { title, summary, stack, cover, coverAlt, links } = project.data;
const coverDescription = coverAlt ?? `Screenshot of ${title}`;

// For link previews: the cover, cropped to 1200 × 630 from the top
const preview = cover
  ? {
      src: (await getImage({ src: cover, width: 1200, height: 630, fit: "cover", position: "top", format: "jpg" })).src,
      alt: coverDescription,
    }
  : undefined;
const { Content } = await render(project);
---

<Base title={title} description={summary} image={preview} kind="article">
  <article>
    <a class="back" href="/">← Projects</a>

    <header class="head">
      <p class="label">{yearOf(project)} · {typeLabel(project)}</p>
      <h1 class="page-title">{title}</h1>
      <p class="summary">{summary}</p>

      {
        stack.length > 0 && (
          <p class="stack">
            <span class="sr-only">Built with </span>
            {stack.join(" · ")}
          </p>
        )
      }

      {
        (links.code || links.demo || links.video) && (
          <p class="links">
            {links.code && <a href={links.code}>Code ↗</a>}
            {links.demo && <a href={links.demo}>Live demo ↗</a>}
            {links.video && <a href={links.video}>Demo video ↗</a>}
          </p>
        )
      }
    </header>

    {cover && <Image class="cover" src={cover} alt={coverDescription} width={1280} loading="eager" />}

    <div class="prose">
      <Content />
    </div>
  </article>

  {
    next && (
      <a class="next" href={`/projects/${next.id}/`}>
        <span class="label">Next project</span>
        <span class="next-title">
          {next.data.title} <span class="arrow">→</span>
        </span>
        <span class="next-summary">{next.data.summary}</span>
      </a>
    )
  }
</Base>

<style>
  .back {
    display: inline-block;
    margin-bottom: 2.5rem;
    font-size: var(--text-sm);
    color: var(--muted);
    text-decoration: none;
  }

  .head {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 2.25rem;
  }

  .summary {
    font-size: var(--text-lg);
    color: var(--muted);
  }

  .stack {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 0.5rem;
    font-size: var(--text-sm);
  }

  .links a {
    color: var(--accent);
  }

  article :global(img.cover) {
    display: block;
    width: 100%;
    /* Crop tall screenshots to a banner, keeping the top */
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    margin-bottom: 2.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  /* A card at the bottom that leads on to the next project */
  .next {
    display: grid;
    gap: 0.25rem;
    margin-top: 4rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg);
    text-decoration: none;
    transition: border-color var(--fast) var(--ease);
  }

  .next:hover {
    border-color: var(--accent);
    color: inherit;
  }

  .next-title {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .next:hover .next-title {
    color: var(--accent);
  }

  .arrow {
    display: inline-block;
    transition: transform var(--fast) var(--ease);
  }

  .next:hover .arrow {
    transform: translateX(4px);
  }

  .next-summary {
    font-size: var(--text-sm);
    color: var(--muted);
  }
</style>
