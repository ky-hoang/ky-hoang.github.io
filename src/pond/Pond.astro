---
/*
  The background: koi in light mode, fireflies in dark mode.

  It is a single canvas fixed behind the page. It ignores clicks, so links
  and text selection work normally on top of it. This folder is
  self-contained; see Base.astro for how to remove it.
*/
---

<canvas id="pond" aria-hidden="true"></canvas>

<script>
  import { startPond } from "./pond";

  const canvas = document.getElementById("pond");
  if (canvas instanceof HTMLCanvasElement) startPond(canvas);
</script>

<style>
  #pond {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
