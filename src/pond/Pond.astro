---
/*
  The background: koi in light mode, fireflies in dark mode.

  It is a single canvas behind the page, as tall as the page, that scrolls
  with it. It ignores clicks, so links and text selection work normally on
  top of it. This folder is self-contained; see Base.astro for how to
  remove it.
*/
---

<!-- transition:persist keeps this same canvas, and the fish on it, across page changes -->
<canvas id="pond" aria-hidden="true" transition:persist></canvas>

<script>
  import { startPond } from "./pond";

  const canvas = document.getElementById("pond");
  if (canvas instanceof HTMLCanvasElement) startPond(canvas);
</script>

<style>
  /* Covers <body>, which is as tall as the page (body is positioned in global.css) */
  #pond {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
