---
/* Top bar: your name on the left; About, Résumé and the light/dark toggle on the right. */
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../content/site";

const onAbout = Astro.url.pathname.startsWith("/about");
---

<header class="header" transition:animate="none">
  <a class="name" href="/">{site.name}</a>
  <nav class="nav" aria-label="Main">
    <a href="/about/" aria-current={onAbout ? "page" : undefined}>About</a>
    {site.resume && <a class="resume" href={site.resume}>Résumé</a>}
    <ThemeToggle />
  </nav>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 2.5rem 0 3.5rem;
  }

  /* Your name and About sit in soft pills, so they read as buttons */
  .name,
  .nav a {
    display: inline-flex;
    align-items: center;
    height: 2.25rem;
    border: 1px solid var(--edge);
    border-radius: 999px;
    background: var(--bg);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .name {
    /* Pulled left so the text still lines up with the column below */
    margin-left: -1rem;
    padding: 0 1rem;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav a {
    padding: 0 1rem;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .name:hover,
  .nav a:hover {
    border-color: var(--accent);
    background: var(--hover);
    color: var(--accent);
  }

  /* The page you are on is filled in softly */
  .nav a[aria-current="page"] {
    background: var(--hover);
    color: var(--text);
  }

  /* Very narrow phones: the Résumé button is already under your intro and in the footer */
  @media (max-width: 23rem) {
    .resume {
      display: none !important;
    }
  }

  @media (min-width: 40rem) {
    .header {
      padding-top: 4.5rem;
    }
  }
</style>
