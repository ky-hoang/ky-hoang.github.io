---
/* Top bar: your name on the left, About and the light/dark toggle on the right. */
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../content/site";

const onAbout = Astro.url.pathname.startsWith("/about");
---

<header class="header" transition:animate="none">
  <a class="name" href="/">{site.name}</a>
  <nav class="nav" aria-label="Main">
    <a href="/about/" aria-current={onAbout ? "page" : undefined}>About</a>
    <ThemeToggle />
  </nav>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 2.5rem 0 3.5rem;
  }

  /* Your name and About are soft pills, so they read as buttons */
  .name,
  .nav a {
    display: inline-flex;
    align-items: center;
    height: 2.25rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .name {
    gap: 0.45rem;
    margin-left: -0.25rem;
    padding: 0 1rem 0 0.85rem;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  /* A small dot in the accent color, like a koi seen from far away */
  .name::before {
    content: "";
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav a {
    padding: 0 0.95rem;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .name:hover,
  .nav a:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    color: var(--accent);
  }

  /* The page you are on: filled in softly */
  .nav a[aria-current="page"] {
    background: var(--hover);
    border-color: color-mix(in srgb, var(--accent) 35%, var(--line));
    color: var(--text);
  }

  @media (prefers-reduced-motion: reduce) {
    .name:hover,
    .nav a:hover {
      transform: none;
    }
  }

  @media (min-width: 40rem) {
    .header {
      padding-top: 4.5rem;
    }
  }
</style>
