---
/*
  One project in the home page list. The whole row links to the project page.
  The cover image is a small thumbnail on phones and a hover preview beside
  the column on wide screens.
*/
import { Image } from "astro:assets";
import { typeLabel, type Project } from "../lib/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, cover, draft } = project.data;
---

<a class:list={["row", { "has-cover": cover }]} href={`/projects/${project.id}/`}>
  {cover && <Image class="thumb" src={cover} alt="" width={560} />}
  <span class="text">
    <span class="title">
      {title}
      {draft && <span class="draft">Draft</span>}
    </span>
    <span class="summary">{summary}</span>
  </span>
  <span class="type label">{typeLabel(project)}</span>
</a>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.15rem 1rem;
    align-items: center;
    margin: 0 -0.75rem;
    padding: 0.7rem 0.75rem;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .row.has-cover {
    grid-template-columns: 4.5rem 1fr;
  }

  .row:hover,
  .row:focus-visible {
    background: var(--hover);
    color: inherit;
  }

  .row :global(img.thumb) {
    grid-row: span 2;
    width: 4.5rem;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .title {
    display: block;
    font-weight: 500;
  }

  .row:hover .title {
    color: var(--accent);
  }

  .summary {
    display: block;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .type {
    grid-column: -2 / -1;
  }

  .draft {
    margin-left: 0.5rem;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--muted);
  }

  /* Tablets and up: the type moves to the right edge of the row */
  @media (min-width: 34rem) {
    .row {
      grid-template-columns: 1fr auto;
    }

    .row.has-cover {
      grid-template-columns: 4.5rem 1fr auto;
    }

    .row :global(img.thumb) {
      grid-row: auto;
    }

    .type {
      grid-column: auto;
    }
  }

  /* Wide screens with a mouse: the cover becomes a preview that appears on hover */
  @media (min-width: 73rem) and (hover: hover) {
    .row.has-cover {
      grid-template-columns: 1fr auto;
    }

    .row :global(img.thumb) {
      position: absolute;
      top: 50%;
      left: calc(100% + 2rem);
      width: 14rem;
      border-radius: var(--radius);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.14);
      opacity: 0;
      transform: translateY(-50%) scale(0.97);
      transition: opacity 0.18s ease, transform 0.18s ease;
      pointer-events: none;
    }

    .row:hover :global(img.thumb),
    .row:focus-visible :global(img.thumb) {
      opacity: 1;
      transform: translateY(-50%) scale(1);
    }
  }

  @media (min-width: 84rem) and (hover: hover) {
    .row :global(img.thumb) {
      width: 17.5rem;
    }
  }
</style>
