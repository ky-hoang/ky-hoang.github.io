---
/*
  One project in the home page list: its name, one-line summary, the tools
  used, and quick links to the code, live demo and demo video when they
  exist. Clicking anywhere else on the row opens the project's page.

  The cover image is a small thumbnail on phones and a hover preview beside
  the column on wide screens.
*/
import { Image } from "astro:assets";
import { typeLabel, type Project } from "../lib/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, cover, draft, stack, links } = project.data;

const quickLinks = [
  { label: "Code", url: links.code },
  { label: "Demo", url: links.demo },
  { label: "Video", url: links.video },
].filter((link) => link.url);
---

<article class:list={["row", { "has-cover": cover }]}>
  {cover && <Image class="thumb" src={cover} alt="" width={560} />}

  <div class="text">
    <h4 class="title">
      <!-- This link stretches over the whole row (see .open::after) -->
      <a class="open" href={`/projects/${project.id}/`}>{title}</a>
      {draft && <span class="draft">Draft</span>}
    </h4>
    <p class="summary">{summary}</p>
    {
      stack.length > 0 && (
        <p class="stack">
          <span class="sr-only">Built with </span>
          {stack.join(" · ")}
        </p>
      )
    }
    {
      quickLinks.length > 0 && (
        <span class="quick">
          {quickLinks.map((link) => (
            <a href={link.url} aria-label={`${title}: ${link.label}`}>
              {link.label}{" "}
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </span>
      )
    }
  </div>

  <span class="type label">{typeLabel(project)}</span>
</article>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem 1rem;
    margin: 0 -0.75rem;
    padding: 0.75rem 0.75rem;
    border-radius: var(--radius);
    transition: background-color var(--fast) var(--ease);
  }

  .row.has-cover {
    grid-template-columns: 4.5rem 1fr;
  }

  .row:hover,
  .row:focus-within {
    background: var(--hover);
  }

  /* Makes the whole row open the project, while the quick links stay clickable on top */
  .open {
    text-decoration: none;
  }

  .open::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .open:focus-visible {
    outline: none;
  }

  .open:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .row :global(img.thumb) {
    width: 4.5rem;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .text {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .row:hover .open {
    color: var(--accent);
  }

  .summary {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .stack {
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .type {
    grid-column: 1 / -1;
  }

  .row.has-cover .type {
    grid-column: 2;
  }

  .quick {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.5rem;
  }

  .quick a {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--edge);
    border-radius: var(--radius-sm);
    background: var(--bg);
    font-size: var(--text-xs);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color var(--fast) var(--ease),
      color var(--fast) var(--ease);
  }

  .quick a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .draft {
    margin-left: 0.5rem;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--muted);
    vertical-align: middle;
  }

  /* Phones: the thumbnail sits beside the title block */
  @media (max-width: 33.99rem) {
    .row.has-cover :global(img.thumb) {
      margin-top: 0.25rem;
    }
  }

  /* Tablets and up: the type moves to the right edge of the row */
  @media (min-width: 34rem) {
    .row {
      grid-template-columns: 1fr auto;
    }

    .row.has-cover {
      grid-template-columns: 4.5rem 1fr auto;
    }

    .type,
    .row.has-cover .type {
      grid-column: auto;
      align-self: start;
      padding-top: 0.25rem;
    }
  }

  /* Wide screens with a mouse: the cover becomes a preview that appears on hover */
  @media (min-width: 73rem) and (hover: hover) {
    .row.has-cover {
      grid-template-columns: 1fr auto;
    }

    .row :global(img.thumb) {
      position: absolute;
      margin-top: 0;
      top: 50%;
      left: calc(100% + 2rem);
      width: 14rem;
      border-radius: var(--radius);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
      opacity: 0;
      transform: translateY(-50%) scale(0.97);
      transition:
        opacity var(--fast) var(--ease),
        transform var(--fast) var(--ease);
      pointer-events: none;
    }

    .row:hover :global(img.thumb),
    .row:focus-within :global(img.thumb) {
      opacity: 1;
      transform: translateY(-50%) scale(1);
    }
  }

  @media (min-width: 84rem) and (hover: hover) {
    .row :global(img.thumb) {
      width: 17.5rem;
    }
  }
</style>
