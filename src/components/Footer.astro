---
/* Bottom of every page: your links from site.ts, plus a hint about the pond. */
import ContactLinks from "./ContactLinks.astro";
---

<footer class="footer" transition:animate="none">
  <ContactLinks />
  <p class="hint" aria-hidden="true">
    <span class="day">Double-click an empty spot to feed the koi.</span>
    <span class="night">Double-click an empty spot to light a spark.</span>
  </p>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 5rem;
    padding: 1.5rem 0 3rem;
    border-top: 1px solid var(--line);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .hint {
    font-size: var(--text-xs);
  }

  .night,
  :global([data-theme="dark"]) .day {
    display: none;
  }

  :global([data-theme="dark"]) .night {
    display: inline;
  }

  /* The pond holds still for visitors who ask for less motion, so skip the hint */
  @media (prefers-reduced-motion: reduce) {
    .hint {
      display: none;
    }
  }
</style>
