---
/*
  Bottom of every page: a favorite quote, your links from site.ts with
  their icons, and a hint about the pond.
*/
import ContactLinks from "./ContactLinks.astro";
---

<footer class="footer" transition:animate="none">
  <figure class="quote">
    <blockquote>“Work hard, be kind, and amazing things will happen.”</blockquote>
    <figcaption>Conan O’Brien</figcaption>
  </figure>
  <ContactLinks />
  <p class="hint" aria-hidden="true">
    Psst, double-<span class="mouse">click</span><span class="touch">tap</span> the pond.
  </p>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 5rem;
    padding: 1.5rem 0 3rem;
    border-top: 1px solid var(--line);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  /* The quote takes a full row of its own, above the links */
  .quote {
    flex-basis: 100%;
    margin-bottom: 0.75rem;
  }

  blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-style: italic;
    line-height: 1.4;
    color: var(--text);
  }

  figcaption {
    margin-top: 0.3rem;
    font-size: var(--text-xs);
  }

  figcaption::before {
    content: "— ";
  }

  .hint {
    font-size: var(--text-xs);
  }

  /* "double-click" with a mouse, "double-tap" on a touch screen */
  .touch {
    display: none;
  }

  @media (hover: none) {
    .mouse {
      display: none;
    }

    .touch {
      display: inline;
    }
  }

  /* The pond holds still for visitors who ask for less motion, so skip the hint */
  @media (prefers-reduced-motion: reduce) {
    .hint {
      display: none;
    }
  }
</style>
