---
/*
  Your links, read from src/content/site.ts, each with its icon.

  Two looks:
  - "large": round icon buttons, with the résumé as a labeled pill. Used at
    the top of the home page. The name of each link shows on hover.
  - "small": a quiet row of icons with their names. Used in the footer.
*/
import Icon from "./Icon.astro";
import { site } from "../content/site";

interface Props {
  size?: "large" | "small";
}

const { size = "small" } = Astro.props;

interface Link {
  label: string;
  url: string;
  icon?: string;
}

const links: Link[] = [
  ...site.links,
  ...(site.email ? [{ label: "Email", url: `mailto:${site.email}`, icon: "email" }] : []),
  ...(site.resume ? [{ label: "Résumé", url: site.resume, icon: "resume" }] : []),
];

// On the home page the résumé stands out as a pill with its name written out
const isPill = (link: Link) => size === "large" && link.icon === "resume";
const showName = (link: Link) => size === "small" || isPill(link);
---

<ul class:list={["links", size]} role="list">
  {
    links.map((link) => (
      <li>
        <a
          class:list={{ pill: isPill(link) }}
          href={link.url}
          aria-label={showName(link) ? undefined : link.label}
          data-tip={showName(link) ? undefined : link.label}
        >
          <Icon name={link.icon} size={size === "large" ? 18 : 16} />
          {showName(link) && <span>{link.label}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  a {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  /* ---------- Small: footer ---------- */

  .small {
    gap: 0.5rem 1.25rem;
  }

  .small a {
    gap: 0.5rem;
  }

  /* ---------- Large: top of the home page ---------- */

  .large {
    gap: 0.5rem;
  }

  .large a {
    position: relative;
    justify-content: center;
    gap: 0.5rem;
    min-width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--edge);
    border-radius: 10px;
    background: var(--bg);
    color: var(--muted);
    transition:
      color var(--fast) var(--ease),
      border-color var(--fast) var(--ease);
  }

  .large a:hover,
  .large a:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  .large .pill {
    padding: 0 1rem 0 1rem;
    font-size: var(--text-sm);
    color: var(--text);
  }

  /* The link's name, floating above its icon on hover */
  .large a[data-tip]::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 0.45rem);
    left: 50%;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    background: var(--text);
    color: var(--bg);
    font-size: var(--text-xs);
    white-space: nowrap;
    opacity: 0;
    transform: translate(-50%, 4px);
    transition:
      opacity var(--fast) var(--ease),
      transform var(--fast) var(--ease);
    pointer-events: none;
  }

  .large a[data-tip]:hover::after,
  .large a[data-tip]:focus-visible::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }

</style>
