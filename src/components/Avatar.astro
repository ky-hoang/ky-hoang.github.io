---
/*
  Your photo, in a circle, at the top of the home page.

  To change it: replace src/content/profile.jpg (a square photo works best;
  other shapes are cropped to the middle). To remove it: delete that file.
*/
import { Image } from "astro:assets";
import { site } from "../content/site";

const found = import.meta.glob<{ default: ImageMetadata }>("../content/profile.{jpg,jpeg,png,webp}", {
  eager: true,
});
const photo = Object.values(found)[0]?.default;
---

{photo && <Image class="avatar" src={photo} alt={`Photo of ${site.name}`} width={360} loading="eager" />}

<style>
  .avatar {
    display: block;
    width: 8.5rem;
    height: 8.5rem;
    border-radius: 50%;
    object-fit: cover;
    /* A thin gap, then a fine ring */
    box-shadow:
      0 0 0 4px var(--bg),
      0 0 0 5px var(--line);
  }
</style>
